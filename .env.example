# Copy this file to .env.local and fill in your keys. Both are optional:
# without them, the app runs in demo mode (browser voice and simple rules).

# Joy, the voice assistant: OpenAI Realtime (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Voice of Joy (for example marin or cedar)
OPENAI_REALTIME_VOICE=marin

# Understanding free requests ("I'd like to sing") in demo mode: Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
